rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isProfessor() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'professor';
    }
    
    function isStudent() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    // /users/{userId}
    // Users can read their own profile.
    // Users can create their own profile.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }

    // /quizzes/{quizId}
    // Any signed-in user can read quizzes.
    // Only professors can create, update, or delete quizzes.
    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isProfessor() && request.resource.data.authorId == request.auth.uid;
    }

    // /quizAttempts/{attemptId}
    // Students can create their own quiz attempts and read their own individual attempts.
    // Professors can read all quiz attempts.
    match /quizAttempts/{attemptId} {
      allow get: if isOwner(resource.data.studentId) || isProfessor();
      allow list: if isProfessor() || (isStudent() && request.query.where[0][2] == request.auth.uid);
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      // Nobody can update or delete past attempts.
      allow update, delete: if false;
    }
  }
}
