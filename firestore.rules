rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Custom claims can be set via a backend function to assign roles.
    // For simplicity, we'll check a 'role' field in a user's profile document.
    function isProfessor() {
      // Assumes a /users/{userId} document exists with a 'role' field.
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'professor';
    }

    // /users/{userId}
    // Users can read/update their own profile.
    // Users can create their own profile if the document userId matches their auth uid.
    match /users/{userId} {
      allow read, update: if isOwner(userId);
      allow create: if isOwner(userId);
    }

    // /quizzes/{quizId}
    // Any signed-in user can read quizzes.
    // Only professors can create, update, or delete quizzes.
    // The authorId of the quiz must match the creator's UID.
    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow create: if isProfessor() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isProfessor() && resource.data.authorId == request.auth.uid;
    }

    // /quizAttempts/{attemptId}
    // Students can create their own quiz attempts.
    // Students can read their own individual quiz attempts.
    // Professors can read all quiz attempts.
    // Students can list/query for their own attempts, professors for all.
    match /quizAttempts/{attemptId} {
      allow get: if isOwner(resource.data.studentId) || isProfessor();
      allow list: if isProfessor() || request.query.where.studentId == request.auth.uid;
      allow create: if isOwner(request.resource.data.studentId);
      // Students cannot update or delete their past attempts.
      allow update, delete: if false;
    }
  }
}
