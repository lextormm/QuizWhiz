rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isProfessor() {
      // Allow either a user document with role 'professor' OR a custom/auth token
      // that contains a role claim. This makes the check robust for both
      // sign-in flows (app-created profile documents) and custom token users.
      return isSignedIn() && (
        request.auth.token.role == 'professor' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'professor'
      );
    }
    
    function isStudent() {
      // Similar to isProfessor(), allow either an auth claim or a users doc role.
      return isSignedIn() && (
        request.auth.token.role == 'student' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
      );
    }

    // /users/{userId}
    // Users can read their own profile.
    // Users can create their own profile.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }

    // /quizzes/{quizId}
    // Any signed-in user can read quizzes.
    // Only professors can create, update, or delete quizzes.
    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isProfessor() && request.resource.data.authorId == request.auth.uid;
    }

    // /quizAttempts/{attemptId}
    // Students can create their own quiz attempts and read their own individual attempts.
    // Professors can read all quiz attempts.
    match /quizAttempts/{attemptId} {
      allow get: if isOwner(resource.data.studentId) || isProfessor();
      // Professors can list all attempts.
      // Students may only list their own attempts — and only when their
      // query explicitly filters on studentId == request.auth.uid.
      // We add safe guards (size checks) so a missing/empty request.query
      // doesn't raise exceptions while rules evaluate.
      allow list: if isProfessor() || (
        isStudent() &&
        // Make sure request.query and where clause exist and look like [field, op, value]
        request.query != null &&
        request.query.where.size() > 0 &&
        request.query.where[0].size() == 3 &&
        request.query.where[0][0] == 'studentId' &&
        request.query.where[0][1] == '==' &&
        request.query.where[0][2] == request.auth.uid
      );
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      // Nobody can update or delete past attempts.
      allow update, delete: if false;
    }
  }
}
